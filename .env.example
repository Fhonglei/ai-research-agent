# AI Research Agent environment variables

# LLM provider: deepseek or anthropic
LLM_PROVIDER=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# Anthropic API, optional. Set LLM_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Search API. If omitted, the backend falls back to DuckDuckGo.
TAVILY_API_KEY=your_tavily_api_key

# Supabase, optional. Without it, reports are stored on local disk.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# Research pipeline controls
MAX_TOPIC_LENGTH=500
SEARCH_MAX_RESULTS=5
FETCH_TOP_N=3
MAX_PARALLEL_RESEARCH_TASKS=4
CONTENT_FETCH_TIMEOUT_SECONDS=10
CONTENT_FETCH_MAX_CHARS=5000
REQUIRE_LLM_FOR_RESEARCH=false
REPORTS_DIR=./reports

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
